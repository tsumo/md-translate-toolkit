{
  "name": "md-translate-toolkit",
  "version": "0.1.0",
  "description": "Config-driven CLI for translating Markdown documents against pinned upstream commits, tracked block by block.",
  "type": "module",
  "license": "MIT",
  "types": "./config.ts",
  "bin": {
    "md-translate": "./cli.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test **/*.test.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "@inquirer/core": "^12.0.2",
    "@inquirer/prompts": "^8.7.1",
    "ajv": "^8.20.0",
    "diff": "^9.0.0",
    "glob": "^13.0.6",
    "mdast-util-to-string": "^4.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "ts-json-schema-generator": "^2.9.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.4.0"
  }
}
